# =============================================================================
# 本机环境变量模板（不包含任何真实密钥）
#
# 用法：
#   1. 复制为 .env（.env 已被 .gitignore 忽略）
#   2. 只在本地填写真实值，禁止提交
#   3. PowerShell 会话中也可以直接设置 $env:DASHSCOPE_API_KEY
# =============================================================================

# 阿里云百炼（DashScope）API Key，同时用于对话与 Embedding
DASHSCOPE_API_KEY=sk-REPLACE_WITH_YOUR_KEY

# RAGFlow 本地地址（部署后按实际端口调整）
RAGFLOW_BASE_URL=http://localhost:8080

# RAGFlow 业务 API Key（在 RAGFlow 界面生成，不是模型 key）
RAGFLOW_API_KEY=

# 可选：DeepSeek 对话模型（第一版未启用）
# DEEPSEEK_API_KEY=

# 可选：本地部署时的数据库/对象存储密码
# 实际值写到 deploy/ragflow/docker/.env，不要写在这里
# MYSQL_PASSWORD=
# MINIO_PASSWORD=
# REDIS_PASSWORD=
# ELASTIC_PASSWORD=
