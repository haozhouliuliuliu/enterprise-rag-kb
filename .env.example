# =============================================================================
# 本机环境变量模板（不包含任何真实密钥）
#
# 用法：
#   1. 复制为 .env（.env 已被 .gitignore 忽略）
#   2. 只在本地填写真实值，禁止提交
#   3. 也可以直接在当前 PowerShell 会话设置同名环境变量
#
# 重要：本文件只是模板。AnythingLLM 桌面版的模型 key 在应用界面
# “设置 -> 模型提供商”中录入并保存在本机数据库；Developer API key
# 在“设置 -> Developer API”中生成，供 tests/eval.py 使用。
# =============================================================================

# 阿里云百炼（DashScope）API Key：用于 qwen-plus 与 text-embedding-v4
DASHSCOPE_API_KEY=sk-REPLACE_WITH_YOUR_KEY

# 百炼 OpenAI 兼容接口
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 本项目锁定的模型
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# AnythingLLM 本机 Developer API（不是模型 key）
# 在 AnythingLLM 设置 -> Developer API 中启用并生成，填入本机 .env
ANYTHINGLLM_BASE_URL=http://127.0.0.1:3001/api/v1
ANYTHINGLLM_WORKSPACE_SLUG=enterprise-rag-kb
ANYTHINGLLM_API_KEY=REPLACE_WITH_DEVELOPER_API_KEY

# 可选：关闭 AnythingLLM 匿名遥测（如通过环境变量启动）
DISABLE_TELEMETRY=true
